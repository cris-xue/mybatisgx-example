		<mybatisgx.sb2.version>0.1.2</mybatisgx.sb2.version>
		<mybatisgx.sb3.version>0.1.2</mybatisgx.sb3.version>
		<mybatisgx.sb4.version>0.1.2-sb4</mybatisgx.sb4.version>
